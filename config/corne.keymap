#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base layer: QWERTY с homerow mods
        base {
            label = "Base";
            bindings = <
                &ht LGUI Q   &ht LALT W   &ht LCTRL E   &ht LSHIFT R   &kp T        &kp Y        &ht RSHIFT U   &ht RCTRL I     &ht RALT O    &ht RGUI P
                &ht LGUI A   &ht LALT S   &ht LCTRL D   &ht LSHIFT F   &kp G        &kp H        &ht RSHIFT J   &ht RCTRL K     &ht RALT L    &ht RGUI SEMI
                &ht LGUI Z   &ht LALT X   &ht LCTRL C   &ht LSHIFT V   &kp B        &kp N        &ht RSHIFT M   &ht RCTRL COMMA &ht RALT DOT  &ht RGUI FSLH
                &lt 1 SPACE  &lt 2 ENTER  &lt 3 TAB     &lt 4 BSPC     &lt 5 DEL    &lt 6 ESC
            >;
        };

        // Layer 1: Symbols
        symbols {
            label = "Symbols";
            bindings = <
                &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT   &kp CARET   &kp AMPS   &kp ASTRK   &kp LPAR   &kp RPAR
                &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH    &kp PIPE    &kp GRAVE  &kp TILDE   &kp LCBR   &kp RCBR
                &kp SEMI   &kp COLON  &kp SQT    &kp DQT    &kp LT      &kp GT      &kp QMARK  &kp UNDER   &kp PLUS   &trans
                &trans     &trans     &trans      &trans     &trans      &trans
            >;
        };

        // Layer 2: Numbers & Numpad
        numbers {
            label = "Numbers";
            bindings = <
                &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6      &kp N7   &kp N8    &kp N9    &kp N0
                &trans   &trans   &trans   &trans   &trans   &kp DOT     &kp COMMA &kp FSLH  &kp ASTRK &kp MINUS
                &trans   &trans   &trans   &trans   &trans   &kp N0      &kp N1   &kp N2    &kp N3    &kp PLUS
                &trans   &trans   &trans   &trans   &trans   &kp EQUAL
            >;
        };

        // Layer 3: Navigation
        nav {
            label = "Navigation";
            bindings = <
                &trans     &trans     &trans      &trans      &trans   &kp HOME   &kp PG_DN    &kp PG_UP    &kp END    &trans
                &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHIFT  &trans   &kp LEFT   &kp DOWN     &kp UP       &kp RIGHT  &kp INS
                &trans     &trans     &trans      &trans      &trans   &kp CAPS   &kp SCROLLLOCK &kp PAUSE_BREAK &kp PSCRN &trans
                &trans     &trans     &trans      &trans      &trans   &trans
            >;
        };

        // Layer 4: Function keys
        function {
            label = "Function";
            bindings = <
                &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6    &kp F7   &kp F8   &kp F9   &kp F10
                &trans   &trans   &trans   &trans   &trans   &kp F11   &kp F12  &trans   &trans   &trans
                &trans   &trans   &trans   &trans   &trans   &trans    &trans   &trans   &trans   &trans
                &trans   &trans   &trans   &trans   &trans   &trans
            >;
        };

        // Layer 5: Media & System
        media {
            label = "Media";
            bindings = <
                &trans   &trans   &trans   &trans   &trans   &kp C_VOL_DN   &kp C_VOL_UP   &kp C_MUTE   &kp C_BRI_DN   &kp C_BRI_UP
                &trans   &trans   &trans   &trans   &trans   &kp C_PREV     &kp C_PP       &kp C_NEXT   &trans         &trans
                &trans   &trans   &trans   &trans   &trans   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2 &bt BT_SEL 3   &bt BT_CLR
                &trans   &trans   &trans   &trans   &trans   &trans
            >;
        };

        // Layer 6: Mouse emulation
        mouse {
            label = "Mouse";
            bindings = <
                &trans   &trans   &trans   &trans   &trans   &mkp MB1          &mkp MB2          &mkp MB3        &trans              &trans
                &trans   &trans   &trans   &trans   &trans   &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_UP    &mmv MOVE_RIGHT     &trans
                &trans   &trans   &trans   &trans   &trans   &msc SCRL_LEFT    &msc SCRL_DOWN    &msc SCRL_UP    &msc SCRL_RIGHT     &trans
                &trans   &trans   &trans   &trans   &trans   &trans
            >;
        };
    };
};
